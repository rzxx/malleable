{
  "id": "hello-tool",
  "name": "Hello Tool",
  "version": "0.0.1",
  "description": "A tiny native TypeScript capsule for proving launch, inspect, watch, and mutate.",
  "entry": {
    "type": "web",
    "main": "src/main.ts",
    "framework": "vanilla",
    "reload": "auto"
  },
  "capabilities": {
    "storage": [
      {
        "scope": "own-data",
        "access": ["delete", "read", "write"]
      }
    ],
    "network": [],
    "commands": [],
    "files": [],
    "system": []
  }
}
