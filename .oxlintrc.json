{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y",
    "react-perf",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "off",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.dev-logs/**",
    "**/*.tsbuildinfo",
    "templates/capsules/basic-static/**"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "maxWarnings": 0
  },
  "rules": {
    "eslint/curly": ["error", "all"],
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-console": "warn",
    "import/no-unassigned-import": "off",
    "eslint/no-implicit-coercion": "error",
    "eslint/no-var": "error",
    "eslint/object-shorthand": ["error", "always"],
    "eslint/prefer-const": ["error", { "destructuring": "all" }],
    "eslint/prefer-template": "error",
    "import/no-duplicates": "error",
    "oxc/no-async-endpoint-handlers": "off",
    "promise/catch-or-return": "error",
    "promise/no-return-wrap": "error",
    "react/jsx-key": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-array-index-key": "warn",
    "react/no-danger": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true,
          "camelCase": true
        }
      }
    ],
    "unicorn/no-null": "off"
  },
  "settings": {
    "react": {
      "version": "19.2.7"
    }
  },
  "overrides": [
    {
      "files": ["apps/shell/**/*.{ts,tsx}"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["services/daemon/**/*.ts", "packages/**/*.ts", "*.config.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    },
    {
      "files": ["templates/capsules/web-react/src/**/*.tsx", "realms/**/capsules/**/src/**/*.tsx"],
      "rules": {
        "react/only-export-components": "error"
      }
    },
    {
      "files": ["types/**/*.d.ts"],
      "rules": {
        "eslint/no-underscore-dangle": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
